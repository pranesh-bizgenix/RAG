# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# development or production (production switches logs to JSON).
# There are no accounts: keep APP_HOST=127.0.0.1 unless everyone on the network may manage documents.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Set to true only when running behind a reverse proxy you control (nginx, Caddy),
# so client IPs and hosts are read from X-Forwarded-* headers.
TRUST_PROXY=false
LOG_LEVEL=INFO
# text or json (defaults to json in production)
LOG_FORMAT=

# ---------------------------------------------------------------------------
# Storage (relative paths resolve from the project folder)
# ---------------------------------------------------------------------------
DATABASE_PATH=storage/app.db
VECTOR_STORE_PATH=storage/vectors.json
DOCUMENTS_DIR=storage/documents

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_FILES_PER_UPLOAD=10
MAX_CONCURRENT_GENERATIONS=8
CHAT_MESSAGES_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
RAG_TOP_K=4
# With API embeddings, passages below this cosine similarity are ignored.
RAG_MIN_VECTOR_SCORE=0.2
# Changing chunking only affects new uploads until you run "Reindex all".
CHUNK_SIZE=180
CHUNK_OVERLAP=40

# ---------------------------------------------------------------------------
# Generation: none, openai-compatible, anthropic, or gemini
# ---------------------------------------------------------------------------
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_FALLBACK_MODELS=
LLM_MAX_RETRIES=2
# Gemini 3 only: minimal, low, medium, or high. Lower is faster.
LLM_THINKING_LEVEL=

# ---------------------------------------------------------------------------
# Optional OpenAI-compatible embeddings. Leave model empty for local embeddings.
# Changing these requires "Reindex all" in the admin Knowledge base page.
# ---------------------------------------------------------------------------
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_TIMEOUT_SECONDS=60
